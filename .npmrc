# @react-navigation/native declares `react-native: "*"` as a peer dependency.
# Some npm versions (notably the one Vercel's build image uses) treat that as
# an unresolvable conflict during a fresh `npm install` in this workspace
# monorepo, even though nothing about it is actually broken — it only affects
# apps/mobile, never apps/web or apps/api. legacy-peer-deps makes npm treat
# peer deps as advisory (npm's pre-v7 behavior) instead of hard failures.
legacy-peer-deps=true
