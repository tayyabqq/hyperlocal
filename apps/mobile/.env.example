# Local dev default matches the Android emulator's host loopback; override for
# a physical device (use your machine's LAN IP) or a real backend.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# From mapbox.com — required for the map view and listing picker.
EXPO_PUBLIC_MAPBOX_TOKEN=
# From mapbox.com (a *secret* download token, different from the public one
# above) — required to install the native Mapbox SDK during a build.
RNMAPBOX_DOWNLOAD_TOKEN=

# From the Firebase console (Android app) — required for push notifications.
# Not committed; place the real file at apps/mobile/google-services.json.
GOOGLE_SERVICES_JSON=./google-services.json
