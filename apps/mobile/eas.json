{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "REPLACE_WITH_STAGING_API_URL",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN",
        "RNMAPBOX_DOWNLOAD_TOKEN": "REPLACE_WITH_MAPBOX_DOWNLOAD_TOKEN"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "REPLACE_WITH_PRODUCTION_API_URL",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN",
        "RNMAPBOX_DOWNLOAD_TOKEN": "REPLACE_WITH_MAPBOX_DOWNLOAD_TOKEN"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
