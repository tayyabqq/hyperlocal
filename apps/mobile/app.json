{
  "expo": {
    "name": "Work Nearby",
    "slug": "work-nearby",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F5F1",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.worknearby.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby job listings and set the pin when you post one."
      }
    },
    "android": {
      "package": "ae.worknearby.app",
      "adaptiveIcon": {
        "backgroundColor": "#14213D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000",
      "mapboxAccessToken": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "REPLACE_WITH_MAPBOX_DOWNLOAD_TOKEN"
        }
      ]
    ]
  }
}