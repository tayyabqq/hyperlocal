NODE_ENV=development
PORT=3000

# Local docker-compose. Production: AWS RDS in me-central-1 (UAE data residency).
DATABASE_URL=postgresql://hl:hl@localhost:5432/hl
REDIS_URL=redis://localhost:6379

# Generate with: ./scripts/gen-jwt-keys.sh
# Paste PEM contents. In production load from AWS Secrets Manager.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# "console" logs the OTP (dev only, refuses to run in production) | "whatsapp"
OTP_PROVIDER=console
# From the Meta app's WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=
# System user access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Must be an approved template in Meta's AUTHENTICATION category.
WHATSAPP_AUTH_TEMPLATE_NAME=otp_login
# Meta locale code for the template, e.g. en_US. Defaults to en_US if unset.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Not read by the app — the Cloud API sends by phone_number_id alone. Only
# needed if you manage templates via the Business Manager API yourself.
WHATSAPP_BUSINESS_ACCOUNT_ID=

CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# "manual" settles orders via a sandbox redirect (dev only, refuses to run in
# production) | "paytabs"
PAYMENT_GATEWAY=manual
API_PUBLIC_URL=http://localhost:3000
# Web page the user lands on after the hosted payment page.
PAYMENT_RETURN_URL=http://localhost:3001/listings/pending

# Required when PAYMENT_GATEWAY=paytabs. Server key is PCI-sensitive: load it
# from AWS Secrets Manager in production, never from a checked-in file.
PAYMENT_CALLBACK_URL=
PAYTABS_BASE_URL=https://secure.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# The launch offer: every user's first listing is free. Set 0 to turn it off.
LAUNCH_FREE_LISTING_CREDITS=1

# Power-user guardrail: max listings per account per rolling week. 0 disables it.
WEEKLY_LISTING_LIMIT=20

# "console" logs pushes (dev only, refuses to run in production) | "fcm"
PUSH_PROVIDER=console
# Required when PUSH_PROVIDER=fcm. Service-account JSON is a secret: load it
# from AWS Secrets Manager in production, never from a checked-in file.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# "local" writes to ./uploads on disk (dev only, refuses to run in
# production — ECS task storage is ephemeral and not shared) | "s3"
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3. No access keys here: the AWS SDK's
# default credential chain picks up the ECS task's IAM role.
S3_BUCKET=
S3_REGION=
# Optional: a CDN in front of the bucket. Falls back to the bucket's own
# regional endpoint when unset.
S3_PUBLIC_BASE_URL=
